# Never paste live credentials here or into source files.
API_BASE_URL=https://quotexfeed.lovable.app
# REQUIRED on Railway; use the PostgreSQL service's reference variable.
# DATABASE_URL=${{Postgres.DATABASE_URL}} (set via Railway UI, not literal dotenv)
# SQLite is for LOCAL PAPER/TEST ONLY; no durable Railway filesystem assumed.
DATABASE_URL=sqlite+aiosqlite:///./qbot.db
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=-1003501100081
DISPLAY_TIMEZONE=Asia/Karachi
CANDLE_INTERVAL=1m
EXPIRY_SECONDS=60
SIGNAL_LEAD_SECONDS=12
MIN_SETUP_SCORE=75
SCAN_INTERVAL_SECONDS=1
MAX_ACTIVE_SIGNALS=1
# PAPER by default: records signals/outcomes, sends NO Telegram messages.
DRY_RUN=true
KILL_SWITCH=false
# Optional secret for authenticated POST /admin/pause/true or /false.
ADMIN_API_KEY=
# Deliberate engineering defaults, not optimized trading thresholds:
DATA_STALE_SECONDS=12
MAX_CLOCK_SKEW_SECONDS=10
ENTRY_QUOTE_TOLERANCE_SECONDS=8
EXPIRY_QUOTE_TOLERANCE_SECONDS=8
RESULT_TIMEOUT_SECONDS=180
# Raw quote retention 2 hours; candles/signals/results are not purged.
# Export/externally archive quotes often for long-term tick replay research.
TICK_RETENTION_SECONDS=7200
STREAM_TRANSPORT=ws
MAX_SYMBOLS_PER_CONNECTION=10
WS_MAX_CONNECTIONS=8
CANDLE_FETCH_CONCURRENCY=6
CANDLE_BACKFILL_LIMIT=2001
RECONCILE_INTERVAL_SECONDS=300
MIN_CLOSED_CANDLES=60
MIN_ATR_PCT=0.00005
MAX_ATR_PCT=0.5
MIN_ATR_NORMALIZED=0.35
MAX_ATR_NORMALIZED=3
MIN_VOL_STABILITY=0.25
MAX_CANDLE_ATR=3.2
MIN_CANDLE_BODY_RATIO=0.12
STRATEGY_CONFIG_FILE=strategy_settings.json
# Empty until a genuine tick-replay held-out artifact is available.
OOS_PERFORMANCE_FILE=
MIN_PERFORMANCE_SAMPLE=50
# BLACK TORNADO directional domains are FIXED 50/50; see JSON family weights.
BT_CONFIG_FILE=black_tornado_settings.json
BT_ENABLED_STRATEGIES=BT01,BT02,BT03,BT04,BT05,BT06,BT07,BT08,BT09,BT10,BT11,BT12,BT13,BT14,BT15,BT16,BT17,BT18,BT19,BT20,BT21,BT22,BT23,BT24,BT25
BT_MAX_TURBULENCE=70
BT_MIN_CONFIDENCE=50
BT_MIN_DIRECTION=18
SCORE_DIRECTION=20
SCORE_TRIGGER=25
SCORE_BEHAVIOR=15
SCORE_REGIME=10
SCORE_TURBULENCE=15
SCORE_HTF=5
SCORE_PERFORMANCE=10
# Default compact message requested by operator. Audit mode adds IDs and BT detail.
TELEGRAM_INCLUDE_AUDIT_DETAILS=false
# Omit SYMBOLS to test all 48 documented canonical symbols.
# SYMBOLS=EURUSD-OTC,GBPUSD-OTC
LOG_LEVEL=INFO
LOG_JSON=true
PORT=8000
